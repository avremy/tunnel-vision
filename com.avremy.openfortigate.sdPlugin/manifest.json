{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Tunnel Vision",
  "Version": "1.3.0.0",
  "Author": "Avremy",
  "Description": "FortiGate VPN keys (openfortivpn on macOS, openconnect on Windows) plus a key that toggles the Mac's own System Settings VPNs — each with live status on the key.",
  "UUID": "com.avremy.openfortigate",
  "Category": "Tunnel Vision",
  "CategoryIcon": "imgs/category-icon",
  "Icon": "imgs/plugin-icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "FortiVPN Profile",
      "UUID": "com.avremy.openfortigate.vpn",
      "Icon": "imgs/action-icon",
      "Tooltip": "Press to connect / disconnect this VPN profile",
      "PropertyInspectorPath": "ui/vpn.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "macOS VPN",
      "UUID": "com.avremy.openfortigate.nativevpn",
      "Icon": "imgs/action-icon",
      "Tooltip": "Press to enable / disable a VPN from System Settings",
      "PropertyInspectorPath": "ui/native.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "UserTitleEnabled": false,
      "OS": [
        "mac"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}