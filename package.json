{
  "name": "streamdeck-openfortigate",
  "version": "1.2.0",
  "description": "Stream Deck plugin to connect/disconnect openfortivpn profiles with live status",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.avremy.openfortigate\"",
    "link": "streamdeck link com.avremy.openfortigate.sdPlugin",
    "restart": "streamdeck restart com.avremy.openfortigate",
    "pack": "streamdeck pack com.avremy.openfortigate.sdPlugin --force -o dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "1.4.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
